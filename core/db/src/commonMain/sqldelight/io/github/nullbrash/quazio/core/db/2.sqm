-- Финансы: счета, дерево категорий, магазины, метки, операции.
-- Все таблицы синхронизируемые: id, account_id, hlc, deleted (удаление — пометкой).

-- Тип задаёт поведение и значение include_in_total по умолчанию (bonus — 0).
CREATE TABLE fin_account (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL,
    name TEXT NOT NULL,
    type TEXT NOT NULL CHECK (type IN ('card', 'savings', 'cash', 'ewallet', 'site_balance', 'bonus', 'credit_card', 'debt')),
    currency TEXT NOT NULL DEFAULT 'RUB',
    opening_balance_minor INTEGER NOT NULL DEFAULT 0,
    credit_limit_minor INTEGER,
    include_in_total INTEGER NOT NULL DEFAULT 1,
    -- Долг: с кем (метка «человек»). Плюс на балансе — мне должны, минус — я должен.
    person_tag_id TEXT,
    archived INTEGER NOT NULL DEFAULT 0,
    sort_key TEXT NOT NULL DEFAULT '',
    hlc TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX fin_account_by_owner ON fin_account(account_id, deleted);

-- Дерево любой глубины; color NULL — цвет родителя (цвет задаёт группа).
CREATE TABLE category (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL,
    parent_id TEXT,
    name TEXT NOT NULL,
    kind TEXT NOT NULL CHECK (kind IN ('expense', 'income')),
    color INTEGER,
    sort_key TEXT NOT NULL DEFAULT '',
    hlc TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX category_by_owner ON category(account_id, kind, deleted);

CREATE TABLE merchant (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL,
    name TEXT NOT NULL,
    -- Для поиска и сопоставления: нижний регистр, без лишних пробелов.
    normalized TEXT NOT NULL,
    default_category_id TEXT,
    hlc TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX merchant_by_name ON merchant(account_id, normalized);

CREATE TABLE tag (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL,
    name TEXT NOT NULL,
    kind TEXT NOT NULL CHECK (kind IN ('topic', 'person', 'organization')),
    hlc TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX tag_by_owner ON tag(account_id, deleted);

-- amount_minor > 0, знак задаёт kind; только у корректировки знак свой.
-- Перевод: со счёта fin_account_id на to_fin_account_id.
CREATE TABLE txn (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL,
    kind TEXT NOT NULL CHECK (kind IN ('expense', 'income', 'transfer', 'adjustment')),
    amount_minor INTEGER NOT NULL,
    currency TEXT NOT NULL DEFAULT 'RUB',
    fin_account_id TEXT NOT NULL,
    to_fin_account_id TEXT,
    category_id TEXT,
    merchant_id TEXT,
    occurred_at INTEGER NOT NULL,
    tz TEXT NOT NULL,
    description TEXT NOT NULL DEFAULT '',
    note TEXT NOT NULL DEFAULT '',
    source TEXT NOT NULL DEFAULT 'manual' CHECK (source IN ('manual', 'quickinput', 'notification', 'import', 'recurring')),
    dedup_key TEXT,
    hlc TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX txn_by_time ON txn(account_id, deleted, occurred_at);
CREATE INDEX txn_by_fin_account ON txn(fin_account_id);
CREATE INDEX txn_by_to_fin_account ON txn(to_fin_account_id);

-- Метки операции. id = txn_id || '|' || tag_id: одна и та же связь на разных
-- устройствах получает один id и сливается при синхронизации.
CREATE TABLE txn_tag (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL,
    txn_id TEXT NOT NULL,
    tag_id TEXT NOT NULL,
    hlc TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX txn_tag_by_txn ON txn_tag(txn_id);
CREATE INDEX txn_tag_by_tag ON txn_tag(tag_id);
