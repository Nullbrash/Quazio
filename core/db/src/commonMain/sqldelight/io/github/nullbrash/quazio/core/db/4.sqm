-- Регулярные платежи: правило, по которому в дни платежа появляются операции.
-- Синхронизируемая таблица (id, account_id, hlc, deleted), как остальные финансы.
-- Операция платежа — обычная строка txn с id «<id платежа>|<дата>»: два устройства
-- не запишут один платёж дважды, а удалённая (или пропущенная) больше не спрашивается.
CREATE TABLE recurring (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL,
    name TEXT NOT NULL,
    kind TEXT NOT NULL CHECK (kind IN ('expense', 'income', 'transfer')),
    amount_minor INTEGER NOT NULL,
    currency TEXT NOT NULL DEFAULT 'RUB',
    fin_account_id TEXT NOT NULL,
    to_fin_account_id TEXT,
    category_id TEXT,
    -- RFC 5545 без «RRULE:»; первая дата — start_date (ISO), последняя — end_date.
    rrule TEXT NOT NULL,
    start_date TEXT NOT NULL,
    end_date TEXT,
    -- ask — спрашивать в день платежа; auto — записывать самому.
    mode TEXT NOT NULL DEFAULT 'ask' CHECK (mode IN ('ask', 'auto')),
    remind_days INTEGER NOT NULL DEFAULT 1,
    paused INTEGER NOT NULL DEFAULT 0,
    -- После паузы: повторения раньше этой даты не спрашиваются и не записываются.
    active_from TEXT,
    -- Платёж 29–31-го (29 февраля — у ежегодного): куда он в месяце без этого числа.
    -- Выбирает пользователь: last — последний день, next — 1-е следующего, skip — пропуск.
    short_month TEXT CHECK (short_month IN ('last', 'next', 'skip')),
    hlc TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX recurring_by_owner ON recurring(account_id, deleted);
